# Application
APP_NAME="Splash CRM"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=

# Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=splash_crm
DB_USERNAME=splash_user
DB_PASSWORD=splash_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# Cache
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Queue
QUEUE_CONNECTION=redis
QUEUE_DRIVER=redis

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@splashcrm.local
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 (for file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# JWT Authentication
JWT_SECRET=
JWT_ALGO=HS256
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=604800

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# External Services
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# ML Service (optional)
ML_SERVICE_ENABLED=false
ML_SERVICE_URL=http://ml-service:8080

# Reporting
REPORT_MAX_SYNC_TIME=30
REPORT_CACHE_TTL=300

# Multi-tenancy
TENANT_MODE=multi
DEFAULT_TENANT_ID=1

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_NAME="${APP_NAME}"

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
