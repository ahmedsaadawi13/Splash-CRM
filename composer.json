{
    "name": "splash/crm",
    "description": "Splash CRM - A comprehensive, enterprise-grade CRM system with advanced reporting, workflows, and multi-tenancy",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=7.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "slim/slim": "^4.0",
        "slim/psr7": "^1.0",
        "php-di/php-di": "^6.0",
        "firebase/php-jwt": "^6.0",
        "vlucas/phpdotenv": "^5.0",
        "illuminate/database": "^8.0",
        "illuminate/pagination": "^8.0",
        "illuminate/validation": "^8.0",
        "predis/predis": "^1.1",
        "monolog/monolog": "^2.0",
        "ramsey/uuid": "^4.0",
        "league/flysystem": "^1.1",
        "league/flysystem-aws-s3-v3": "^1.0",
        "phpoffice/phpspreadsheet": "^1.18",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "mockery/mockery": "^1.4",
        "fakerphp/faker": "^1.19",
        "phpstan/phpstan": "^1.0",
        "squizlabs/php_codesniffer": "^3.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/",
            "Database\\Migrations\\": "database/migrations/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "phpstan": "phpstan analyse app --level=5",
        "phpcs": "phpcs --standard=PSR12 app",
        "phpcbf": "phpcbf --standard=PSR12 app",
        "migrate": "php bin/migrate.php",
        "seed": "php bin/seed.php",
        "serve": "php -S localhost:8000 -t public"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
